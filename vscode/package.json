{
  "name": "omnexx",
  "displayName": "omnexx",
  "description": "Chat with the omnexx coding agent right in your editor, with omnexx built in: chat, plan or run autonomously, see token use and cost, and watch long runs' todo lists.",
  "version": "0.15.0",
  "publisher": "yaegerbomb42",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaegerbomb42/omnexx.git",
    "directory": "vscode"
  },
  "homepage": "https://omnexx.org",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agent",
    "coding agent",
    "autonomous",
    "ollama"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnexx",
          "title": "omnexx",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "omnexx": [
        {
          "type": "webview",
          "id": "omnexx.chat",
          "name": "Chat"
        },
        {
          "id": "omnexx.runs",
          "name": "History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "omnexx.runs",
        "contents": "No chats or runs for this folder yet.\n[Start run](command:omnexx.startRun)\n[Autonomous for N hours](command:omnexx.startAutonomous)\n[Open chat in terminal](command:omnexx.openChat)"
      }
    ],
    "commands": [
      {
        "command": "omnexx.startRun",
        "title": "Start Run",
        "category": "omnexx",
        "icon": "$(play)"
      },
      {
        "command": "omnexx.startAutonomous",
        "title": "Autonomous for N Hours",
        "category": "omnexx",
        "icon": "$(rocket)"
      },
      {
        "command": "omnexx.openChat",
        "title": "Open Chat in Terminal",
        "category": "omnexx",
        "icon": "$(terminal)"
      },
      {
        "command": "omnexx.refresh",
        "title": "Refresh History",
        "category": "omnexx",
        "icon": "$(refresh)"
      },
      {
        "command": "omnexx.attach",
        "title": "Watch in Terminal",
        "category": "omnexx",
        "icon": "$(terminal)"
      },
      {
        "command": "omnexx.pause",
        "title": "Pause Run",
        "category": "omnexx",
        "icon": "$(debug-pause)"
      },
      {
        "command": "omnexx.resume",
        "title": "Resume Run",
        "category": "omnexx",
        "icon": "$(debug-continue)"
      },
      {
        "command": "omnexx.stop",
        "title": "Stop Run",
        "category": "omnexx",
        "icon": "$(debug-stop)"
      },
      {
        "command": "omnexx.focusChat",
        "title": "Open Chat",
        "category": "omnexx",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "omnexx.newChat",
        "title": "New Chat",
        "category": "omnexx",
        "icon": "$(add)"
      },
      {
        "command": "omnexx.pickModel",
        "title": "Pick Chat Model",
        "category": "omnexx",
        "icon": "$(sparkle)"
      },
      {
        "command": "omnexx.restartChat",
        "title": "Restart Chat",
        "category": "omnexx",
        "icon": "$(debug-restart)"
      },
      {
        "command": "omnexx.openSettings",
        "title": "Settings",
        "category": "omnexx",
        "icon": "$(gear)"
      },
      {
        "command": "omnexx.inspectContext",
        "title": "Inspect Context",
        "category": "omnexx",
        "icon": "$(layers)"
      },
      {
        "command": "omnexx.toggleApproval",
        "title": "Toggle Auto-Approve",
        "category": "omnexx"
      },
      {
        "command": "omnexx.toggleTrace",
        "title": "Toggle Per-Turn Trace",
        "category": "omnexx"
      },
      {
        "command": "omnexx.undoLast",
        "title": "Undo Last Message's Edits",
        "category": "omnexx",
        "icon": "$(discard)"
      },
      {
        "command": "omnexx.compactChat",
        "title": "Compact Conversation",
        "category": "omnexx",
        "icon": "$(fold)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "omnexx.startRun",
          "when": "view == omnexx.runs",
          "group": "navigation@1"
        },
        {
          "command": "omnexx.startAutonomous",
          "when": "view == omnexx.runs",
          "group": "navigation@2"
        },
        {
          "command": "omnexx.openChat",
          "when": "view == omnexx.runs",
          "group": "navigation@3"
        },
        {
          "command": "omnexx.refresh",
          "when": "view == omnexx.runs",
          "group": "navigation@4"
        },
        {
          "command": "omnexx.newChat",
          "when": "view == omnexx.chat",
          "group": "navigation@1"
        },
        {
          "command": "omnexx.pickModel",
          "when": "view == omnexx.chat",
          "group": "navigation@2"
        },
        {
          "command": "omnexx.restartChat",
          "when": "view == omnexx.chat",
          "group": "overflow@1"
        },
        {
          "command": "omnexx.openChat",
          "when": "view == omnexx.chat",
          "group": "overflow@2"
        },
        {
          "command": "omnexx.inspectContext",
          "when": "view == omnexx.chat",
          "group": "navigation@3"
        },
        {
          "command": "omnexx.openSettings",
          "when": "view == omnexx.chat",
          "group": "navigation@4"
        },
        {
          "command": "omnexx.toggleApproval",
          "when": "view == omnexx.chat",
          "group": "overflow@0"
        },
        {
          "command": "omnexx.toggleTrace",
          "when": "view == omnexx.chat",
          "group": "overflow@0"
        },
        {
          "command": "omnexx.undoLast",
          "when": "view == omnexx.chat",
          "group": "overflow@1"
        },
        {
          "command": "omnexx.compactChat",
          "when": "view == omnexx.chat",
          "group": "overflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "omnexx.attach",
          "when": "view == omnexx.runs && viewItem =~ /^run\\./",
          "group": "inline@1"
        },
        {
          "command": "omnexx.pause",
          "when": "view == omnexx.runs && viewItem == run.active",
          "group": "inline@2"
        },
        {
          "command": "omnexx.stop",
          "when": "view == omnexx.runs && viewItem =~ /^run\\.(active|fix)$/",
          "group": "inline@3"
        },
        {
          "command": "omnexx.resume",
          "when": "view == omnexx.runs && viewItem =~ /^run\\.(ended|fix)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "omnexx.attach",
          "when": "false"
        },
        {
          "command": "omnexx.pause",
          "when": "false"
        },
        {
          "command": "omnexx.resume",
          "when": "false"
        },
        {
          "command": "omnexx.stop",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "omnexx",
      "properties": {
        "omnexx.path": {
          "type": "string",
          "default": "",
          "description": "Path to the omnexx executable. Empty uses omnexx on PATH (install with: npm i -g omnexx).",
          "scope": "machine-overridable"
        },
        "omnexx.showAllRuns": {
          "type": "boolean",
          "default": false,
          "description": "List runs from every repository, not only the open folders."
        },
        "omnexx.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often the sidebar re-reads a live run's todo list. Takes effect after a reload."
        },
        "omnexx.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Start chats in auto-approve mode: omnexx goes ahead without asking before guarded actions (hard-blocked commands stay blocked)."
        }
      }
    },
    "keybindings": [
      {
        "command": "omnexx.focusChat",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && npx @vscode/vsce package --no-dependencies"
  }
}
